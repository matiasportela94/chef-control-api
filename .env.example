SPRING_PROFILES_ACTIVE=local

DATABASE_URL=jdbc:postgresql://localhost:5432/chefcontrol
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

JWT_SECRET=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemma-4

AI_SERVICE_SECRET=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Mail (SMTP). Gmail: verificación en 2 pasos + contraseña de aplicación (no la normal).
MAIL_PROVIDER=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
# Opcional: por defecto MAIL_USERNAME. En Gmail debe ser esa cuenta o un alias suyo.
MAIL_FROM=

# Acceder con Google: OAuth Client ID tipo "Aplicación web" (Google Cloud Console > Credenciales).
# El mismo valor va en environment*.ts del front. Vacío = el botón no aparece y el endpoint rechaza todo.
GOOGLE_CLIENT_ID=

# MercadoPago. Usar las credenciales de PRUEBA fuera de producción. MP_PUBLIC_KEY hoy no la lee el código (no hay MP.js en el flujo).
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
# Comprador de prueba de MP (solo con credenciales de prueba): va como pagador en lugar del email del dueño.
MP_TEST_PAYER_EMAIL=

# URL pública del backend: MercadoPago la usa para avisarnos de los pagos (webhook).
# En local no sirve localhost: hace falta un túnel (ngrok, cloudflared) y poner acá su URL https.
BACKEND_PUBLIC_URL=
# Precio mensual en ARS. Comentadas a propósito: una variable definida pero VACÍA pisa el default y rompe el arranque.
#SUBSCRIPTION_STARTER_AMOUNT_ARS=100000
#SUBSCRIPTION_PRO_AMOUNT_ARS=170000
#SUBSCRIPTION_ENTERPRISE_AMOUNT_ARS=225000
#SUBSCRIPTION_ANNUAL_DISCOUNT_PERCENT=15
